rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Visits collection: Public visitors can record their guest visits, read and managed by Posbakum system
    match /visits/{visitId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    // Real-time cross-computer notifications for admin posbakum
    match /admin_notifications/{notificationId} {
      allow read: if true;
      allow write: if true;
    }

    // Logs collection
    match /activity_logs/{logId} {
      allow read: if true;
      allow write: if true;
    }

    // Registered admin devices for audit log
    match /admin_devices/{deviceId} {
      allow read: if true;
      allow write: if true;
    }

    // QR tokens & Desk settings
    match /qr_tokens/{tokenId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
